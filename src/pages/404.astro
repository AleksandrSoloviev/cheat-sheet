---
import Base from '../layouts/Base.astro';
import { isLocale, t, type Locale } from '../i18n/ui';

const segment = Astro.url.pathname.split('/').filter(Boolean)[0];
const locale: Locale = isLocale(segment) ? segment : 'ru';
---

<Base title={t(locale, 'notFound.title')} locale={locale}>
  <script is:inline>
    (function () {
      var parts = location.pathname.split('/').filter(Boolean);
      var first = parts[0];
      if (!first || first === 'ru' || first === 'en') return;
      parts[0] = 'ru';
      var next = '/' + parts.join('/');
      if (!next.endsWith('/')) next += '/';
      location.replace(next + location.search + location.hash);
    })();
  </script>
  <h1>{t(locale, 'notFound.title')}</h1>
  <p><a href={`/${locale}/`}>{t(locale, 'notFound.home')}</a></p>
</Base>
