---
import { renderMarkdown } from '../lib/markdown';
import { t, type Locale } from '../i18n/ui';

interface Question {
  id: string;
  title: string;
  body: string;
}

interface DayPanel {
  day: 'day1' | 'day2' | 'day3' | 'optional' | 'catalog';
  title: string;
  questions: Question[];
}

interface Props {
  locale: Locale;
  days: DayPanel[];
  terms: string;
  lifecycle: string;
  mode?: 'days' | 'catalog';
}

const { locale, days, terms, lifecycle } = Astro.props;
const mode = Astro.props.mode ?? 'days';
const isCatalog = mode === 'catalog';
const tabs = isCatalog
  ? []
  : [
      ...days.map((day) => ({ id: day.day, label: t(locale, `roadmap.${day.day}` as 'roadmap.day1') })),
      { id: 'glossary', label: t(locale, 'roadmap.glossary') },
    ];
---

<div
  class="roadmap-app"
  data-roadmap
  data-catalog={isCatalog ? 'true' : 'false'}
  data-done-key={isCatalog ? 'next-roadmap-done-v1' : 'vue-roadmap-done-v1'}
  data-tab-key={isCatalog ? undefined : 'vue-roadmap-tab-v1'}
>
<p class="progress"><span data-roadmap-count>0</span> {t(locale, 'roadmap.done')}</p>
{
  !isCatalog && (
    <div class="tabs" role="tablist">
      {tabs.map((tab) => (
        <button type="button" class="tab" data-tab={tab.id} aria-pressed="false">
          {tab.label}
        </button>
      ))}
    </div>
  )
}

{
  days.map((day) => (
    <section class="day-panel" data-panel={day.day} hidden={isCatalog ? undefined : true}>
      <div class="day-head">
        <h2>{day.title}</h2>
      </div>
      {day.questions.map((question) => (
        <details class="q" data-day={day.day}>
          <summary class="q-sum">
            <label class="check" onclick="event.stopPropagation()">
              <input type="checkbox" data-check={question.id} />
            </label>
            <span class="qid">Q{question.id}</span>
            <span class="qtitle">{question.title}</span>
          </summary>
          <div class="q-body" set:html={renderMarkdown(question.body)} />
        </details>
      ))}
    </section>
  ))
}

{
  !isCatalog && (
<section class="day-panel" data-panel="glossary" hidden>
  <div class="tabs">
    <button type="button" class="tab" data-gloss="terms" aria-pressed="true">{t(locale, 'roadmap.terms')}</button>
    <button type="button" class="tab" data-gloss="lifecycle" aria-pressed="false">{t(locale, 'roadmap.lifecycle')}</button>
  </div>
  <div data-gloss-panel="terms" set:html={renderMarkdown(terms)} />
  <div data-gloss-panel="lifecycle" hidden set:html={renderMarkdown(lifecycle)} />
</section>
  )
}

</div>
<script is:inline>
  document.querySelectorAll('[data-roadmap]').forEach(function (root) {
    var catalog = root.getAttribute('data-catalog') === 'true';
    var doneKey = root.getAttribute('data-done-key') || (catalog ? '' : 'vue-roadmap-done-v1');
    var tabKey = root.getAttribute('data-tab-key') || '';
    var storageOk = true;
    var done = new Set();
    if (!doneKey) {
      storageOk = false;
    } else {
      try {
        var parsed = JSON.parse(localStorage.getItem(doneKey) || '[]');
        if (Array.isArray(parsed)) parsed.forEach(function (id) { done.add(String(id)); });
      } catch (error) {
        storageOk = false;
        done = new Set();
      }
    }

    function showTab(name) {
      root.querySelectorAll('[data-panel]').forEach(function (panel) {
        panel.hidden = panel.getAttribute('data-panel') !== name;
      });
      root.querySelectorAll('[data-tab]').forEach(function (button) {
        button.setAttribute('aria-pressed', button.getAttribute('data-tab') === name ? 'true' : 'false');
      });
      if (!storageOk || !tabKey) return;
      try { localStorage.setItem(tabKey, name); } catch (error) {}
    }

    function updateCount() {
      var node = root.querySelector('[data-roadmap-count]');
      if (node) node.textContent = String(done.size);
    }

    if (doneKey) {
      root.querySelectorAll('[data-check]').forEach(function (input) {
        var id = input.getAttribute('data-check') || '';
        input.checked = storageOk && done.has(id);
        input.addEventListener('change', function () {
          if (input.checked) done.add(id);
          else done.delete(id);
          updateCount();
          try { localStorage.setItem(doneKey, JSON.stringify(Array.from(done))); } catch (error) {}
        });
      });
    }

    root.querySelectorAll('[data-tab]').forEach(function (button) {
      button.addEventListener('click', function () {
        showTab(button.getAttribute('data-tab') || 'day1');
      });
    });

    root.querySelectorAll('[data-gloss]').forEach(function (button) {
      button.addEventListener('click', function () {
        var name = button.getAttribute('data-gloss');
        root.querySelectorAll('[data-gloss-panel]').forEach(function (panel) {
          panel.hidden = panel.getAttribute('data-gloss-panel') !== name;
        });
        root.querySelectorAll('[data-gloss]').forEach(function (item) {
          item.setAttribute('aria-pressed', item === button ? 'true' : 'false');
        });
      });
    });

    if (!catalog) {
      var initial = 'day1';
      if (storageOk && tabKey) {
        try { initial = localStorage.getItem(tabKey) || 'day1'; } catch (error) { initial = 'day1'; }
      }
      if (!root.querySelector('[data-panel="' + initial + '"]')) initial = 'day1';
      showTab(initial);
    }
    updateCount();
  });
</script>
